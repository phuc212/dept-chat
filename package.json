{
  "name": "dept-chat",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:cf": "wrangler pages dev",
    "test": "node --test tests/*.test.mjs",
    "deploy": "node tools/build-kho.mjs --if-missing && wrangler pages deploy public --project-name dept-chat --branch main",
    "kho": "node tools/build-kho.mjs",
    "pretest": "node tools/build-kho.mjs --if-missing",
    "predev": "node tools/build-kho.mjs --if-missing",
    "kho:drive": "node tools/sync-drive.mjs"
  },
  "devDependencies": {
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.3",
    "unpdf": "^1.8.1",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
